{
  "name": "badapple-ascii-player",
  "displayName": "Bad Apple!! ASCII in VSCode ",
  "description": "Watch Bad Apple!! in real-time Black & White ASCII art inside your VS Code Sidebar or Editor tab.",
  "version": "1.3.0",
  "publisher": "SinsuSquid",
  "private": false,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/SinsuSquid/BadApple-ASCII"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "keywords": [
    "bad apple",
    "ascii",
    "ascii art",
    "sidebar",
    "retro",
    "monochrome",
    "crt"
  ],
  "icon": "media/icon.png",
  "main": "./extension.js",
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "activationEvents": [
    "onView:badapple.sidebarView"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "badapple-explorer",
          "title": "Bad Apple!! ASCII",
          "icon": "media/icon.png"
        }
      ]
    },
    "views": {
      "badapple-explorer": [
        {
          "type": "webview",
          "id": "badapple.sidebarView",
          "name": "Bad Apple!! ASCII",
          "icon": "media/icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "badapple.openTab",
        "title": "Bad Apple!!: Open ASCII in Editor Tab",
        "category": "Bad Apple",
        "icon": "$(screen-full)"
      },
      {
        "command": "badapple.focusSidebar",
        "title": "Bad Apple!!: Show in Sidebar",
        "category": "Bad Apple",
        "icon": "$(layout-sidebar-left)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "badapple.focusSidebar"
        },
        {
          "command": "badapple.openTab"
        }
      ],
      "view/title": [
        {
          "command": "badapple.openTab",
          "when": "view == badapple.sidebarView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "Bad Apple!! ASCII Player",
      "properties": {
        "badapple.charset": {
          "type": "string",
          "default": "standard",
          "enum": [
            "standard",
            "detailed",
            "blocks",
            "braille",
            "matrix",
            "binary",
            "katakana"
          ],
          "description": "ASCII character density palette."
        },
        "badapple.resolution": {
          "type": "string",
          "default": "auto",
          "enum": [
            "auto",
            "40",
            "50",
            "60",
            "80",
            "100",
            "120",
            "150"
          ],
          "description": "Horizontal character resolution column count."
        },
        "badapple.crtScanlines": {
          "type": "boolean",
          "default": true,
          "description": "Enable vintage CRT scanline and glow effects."
        },
        "badapple.loop": {
          "type": "boolean",
          "default": true,
          "description": "Automatically loop video playback."
        },
        "badapple.inverted": {
          "type": "boolean",
          "default": false,
          "description": "Invert black & white luminance mapping."
        },
        "badapple.contrast": {
          "type": "number",
          "default": 1.2,
          "description": "Contrast multiplier for ASCII rendering (0.5 to 3.0)."
        }
      }
    }
  }
}
